{
    "name": "extra-type",
    "version": "0.1.0-alpha",
    "description": "Dictation for Linux Wayland, reworked from voice-type",
    "type": "module",
    "os": [
        "linux"
    ],
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target node",
        "test": "bun test tests",
        "test:watch": "bun test --watch tests",
        "test:coverage": "bun test --coverage tests"
    },
    "dependencies": {
        "dbus-next": "^0.10.2",
        "express": "^5.2.1",
        "puppeteer-core": "^24.39.1",
        "x11": "^2.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "bun": "^1.3.11",
        "bun-types": "^1.3.11",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    }
}
